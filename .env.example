# Database Configuration with Connection Pooling
# ================================================
#
# This uses Neon PostgreSQL with PgBouncer connection pooling.
# Connection pooling is CRITICAL for serverless environments.
# Without it, you'll get "too many connections" errors.

# Local Development (Direct Connection)
# - Uses Neon's direct endpoint
# - No PgBouncer (slower but fine for local)
# - Larger pool size (more connections available for testing)
# DATABASE_URL="postgresql://user:password@direct.neon.tech/dbname?sslmode=require"

# Production/Staging (Pooled Connection - RECOMMENDED)
# - Uses Neon's pooler endpoint (.pooler. in the URL)
# - Enables PgBouncer automatically
# - Smaller pool size (optimized for serverless)
# - Connection pooling parameters added automatically
DATABASE_URL="postgresql://user:password@ep-example-pooler.neon.tech/dbname?sslmode=require&channel_binding=require"

# What the configuration does automatically:
# =========================================
#
# 1. pgbouncer=true
#    → Enables connection pooling via Neon's PgBouncer
#    → Multiplexes many connections onto fewer DB connections
#    → Prevents "too many connections" errors
#
# 2. max_pool_size=3 (serverless) or 10 (local)
#    → Maximum connections from app to database
#    → Serverless: Keep small (3) to avoid exhausting pool
#    → Local: Larger (10) is fine for development
#
# 3. min_pool_size=1 (serverless) or 2 (local)
#    → Minimum connections kept alive
#    → Serverless: Minimal (1) to save resources
#    → Local: Keep a few (2) to avoid cold starts during testing
#
# 4. statement_cache_size=20 (serverless) or 50 (local)
#    → Caches compiled queries to avoid re-parsing
#    → Serverless: Smaller (20) since connections are short-lived
#    → Local: Larger (50) for better performance in dev
#
# 5. idle_in_transaction_session_timeout=5000ms (serverless) or 30000ms (local)
#    → Kills connections idle inside transactions
#    → Serverless: Aggressive (5s) to free connections quickly
#    → Local: Longer (30s) for interactive development
#
# 6. statement_timeout=30000ms (serverless) or 60000ms (local)
#    → Maximum query execution time
#    → Serverless: Shorter (30s) since functions should return quickly
#    → Local: Longer (60s) for debugging
#
# These parameters are added automatically by src/lib/databaseUrl.ts
# based on your environment (NODE_ENV + serverless detection).

# Example: Converting from direct to pooled endpoint
# ==================================================
#
# Direct (slow for serverless):
# postgresql://user:pass@direct-neon.c-7.aws.neon.tech/dbname
#
# Pooled (fast for serverless - RECOMMENDED):
# postgresql://user:pass@project-pooler.neon.tech/dbname
#
# Notice: "direct" becomes "project-pooler"
# This endpoint uses PgBouncer automatically.

# ================================================================================
# Other Configuration Variables (not database-specific)
# ================================================================================

# Auth Configuration
AUTH_SECRET="generate-with: openssl rand -base64 32"
AUTH_TRUST_HOST="true"

# LLM/Transcription
OPENAI_API_KEY="sk-..."
OLLAMA_API_URL="http://localhost:11434"
OLLAMA_MODEL="mistral"

# App URLs
NEXTAUTH_URL="http://localhost:3000"

# Email & Notifications
RESEND_API_KEY="re_..."
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""
CRON_SECRET="generate-with: openssl rand -base64 32"
EMAIL_FROM="noreply@yourdomain.com"

# Image Hosting
CLOUDINARY_CLOUD_NAME="..."
CLOUDINARY_API_KEY="..."
CLOUDINARY_API_SECRET="..."

# Task Queuing
INNGEST_SIGNING_KEY="signkey-..."
INNGEST_EVENT_KEY="..."

# Redis Caching (optional)
REDIS_URL="redis://localhost:6379"

# ================================================================================
# Deployment Checklist
# ================================================================================
#
# □ DATABASE_URL uses pooler endpoint (not direct)
# □ sslmode is set to "require" or "verify-full" (security)
# □ channel_binding=require is set (Neon security feature)
# □ Secrets are stored in environment (not in .env file)
# □ Different URLs for local vs production
# □ Verified connections work before deploying
# □ Monitoring is set up for connection pool usage
# □ Alerts configured for "too many connections" errors

# ================================================================================
# Monitoring Connection Pool Health
# ================================================================================
#
# Check active connections:
# psql $DATABASE_URL -c "SELECT count(*) FROM pg_stat_activity WHERE state = 'active';"
#
# Check idle connections:
# psql $DATABASE_URL -c "SELECT count(*) FROM pg_stat_activity WHERE state = 'idle';"
#
# Expected values for serverless:
# - Active: 0-2 (queries actively running)
# - Idle: 1-3 (in connection pool, waiting)
# - Total: 3-5 connections max
#
# Red flags:
# - Total connections > 10 (something is wrong)
# - Same connection holding session (transaction not completing)
# - Frequent "too many connections" errors (pool exhausted)

# ================================================================================
# Production Deployment for Vercel
# ================================================================================
#
# 1. Set DATABASE_URL in Vercel environment variables
#    - Use pooled endpoint (.pooler. in URL)
#    - Example: postgresql://user:pass@project-pooler.neon.tech/dbname
#
# 2. Verify connection works:
#    npm run db:migrate --production
#
# 3. Monitor Neon dashboard:
#    - Watch active connections
#    - Set alerts for connection limit exceeded
#
# 4. Load test:
#    - Simulate 100+ concurrent requests
#    - Verify connections stay under 10
#    - Watch for "too many connections" errors

# ================================================================================
# Production Deployment for AWS Lambda
# ================================================================================
#
# 1. Set DATABASE_URL in Lambda environment
# 2. Consider VPC configuration:
#    - Lambda in same VPC as database (if private)
#    - Or use Neon's public endpoint with SSL
# 3. Monitor CloudWatch logs:
#    - Filter: [PRISMA ERROR] too many connections
#    - Filter: [SLOW QUERY] (queries taking >500ms)
# 4. Consider Lambda concurrency settings:
#    - Reserved concurrency limits connections
#    - Start conservative (10), increase based on load

# ================================================================================
# Troubleshooting: Database Connection Issues
# ================================================================================
#
# Error: "too many connections"
# ✗ Wrong: Create new PrismaClient per request
# ✓ Right: Use singleton pattern (already implemented in src/lib/prisma.ts)
#
# Error: "Connection timeout"
# ✗ Wrong: Increase timeout to 30s
# ✓ Right: Check if queries are too slow, optimize them first
#
# Error: "Idle in transaction timeout"
# ✗ Wrong: Remove the timeout
# ✓ Right: Complete transactions faster (commit/rollback)
#
# Error: "SSL certificate verification failed"
# ✗ Wrong: Use sslmode=disable
# ✓ Right: Verify sslmode=verify-full, check CA certificate
