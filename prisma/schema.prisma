// Smart Meeting & Attendance Logger — data model
// Derived from Smart meeting.md (PRD v1.0). See ../IMPLEMENTATION_PLAN.md section 2.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Enums ───────────────────────────────────────────────────────────────────

/// Ministry role hierarchy (PRD §7 RBAC).

/// System role: what a user can do (access level), independent of job title.
enum SystemRole {
  SUPER_ADMIN // platform-wide admin
  MINISTRY_ADMIN // ministry admin (same as old ADMIN role)
  EVENT_MANAGER // create/manage events, attendance, letters (same as old ADMIN_STAFF role)
  EXECUTIVE_ASSISTANT // PA/secretary role: event/attendee/letters management but no user/room/minutes-publish access
  APPROVER // approve and publish minutes (former PERMANENT_SECRETARY/DEPUTY_SECRETARY)
  EXECUTIVE_VIEWER // read-only access to ministry-wide schedule and published minutes (former senior leadership)
  STAFF // regular staff with no special capabilities (former STAFF_MEMBER)
}

enum EventType {
  MEETING
  CONFERENCE
  APPOINTMENT
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  WEEKDAYS
  MONTHLY
}

enum RecurrenceEndType {
  COUNT
  UNTIL
}

/// Letter / invitation color category (PRD §6.5).
enum ColorCategory {
  RED // urgent / cabinet
  AMBER // internal
  GREEN // routine
}

/// Meeting classification tier (PRD §6.2).
enum Classification {
  PUBLIC
  RESTRICTED
}

enum CheckInMethod {
  QR
  MANUAL
  GEO
}

enum InviteStatus {
  INVITED
  CONFIRMED
  DECLINED
}

enum RecordingStatus {
  UPLOADED
  PROCESSING
  TRANSCRIBED
  FAILED
}

enum MinutesStatus {
  DRAFT
  PUBLISHED
}

/// Public calendar event status — separate from internal smart-meeting events.
enum PublicEventStatus {
  DRAFT
  PUBLISHED
}

enum PublicEventCategory {
  CONFERENCE
  WORKSHOP
  TRAINING
  MEETING
  ANNOUNCEMENT
  PUBLIC_NOTICE
  OTHER
}

enum ActionItemStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum ActionItemPoint {
  ACTION_POINT
  AGREED
}

enum RoomBookingPurpose {
  MEETING
  TRAINING
  CONFERENCE
  WORKSHOP
  INTERVIEW
  OTHER
}

enum RoomBookingStatus {
  CONFIRMED
  CANCELLED
}

// ── Core models ─────────────────────────────────────────────────────────────

model Ministry {
  id          String   @id @default(cuid())
  name        String   @unique // e.g. "Ministry of Health"
  code        String   @unique // short slug, e.g. "MOH"
  emailDomain String?  @unique // gov.sl subdomain that maps logins to this ministry, e.g. "mocti.gov.sl"
  active      Boolean  @default(true)
  compoundLat Float?
  compoundLng Float?
  compoundGeofenceRadius Int @default(100)
  compoundMaxGpsAccuracy Int @default(75)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users         User[]
  events        Event[]
  eventSeries   EventSeries[]
  rooms         Room[]
  roomBookings  RoomBooking[]
  auditLogs     AuditLog[]
  notifications Notification[]
  publicEvents  PublicEvent[]
  invitedPublicEvents PublicEvent[] @relation("PublicEventInvites")
}

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  name          String?
  passwordHash  String? // for credential/OTP fallback
  systemRole    SystemRole @default(STAFF) // what the user can do (access level)
  jobTitle      String? // P2: who the user is (org title, e.g. "Minister", "Director")
  ministryId    String? // null for SUPER_ADMIN users
  ministry      Ministry?    @relation(fields: [ministryId], references: [id], onDelete: Cascade)
  active        Boolean      @default(true) // deactivated users cannot log in
  phone         String? // for SMS notifications (action item reminders, etc.)
  emailVerified DateTime?
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  // Preferences
  emailNotifications      Boolean @default(true)
  meetingReminders        Boolean @default(true)
  actionItemNotifications Boolean @default(true)
  theme                   String  @default("dark") // dark, light, auto
  compactMode             Boolean @default(false)
  sessionTimeout          Int     @default(30) // minutes
  autoDeleteRecordings    Boolean @default(false)

  organizedEvents   Event[]         @relation("EventOrganizer")
  coOrganizedEvents Event[]         @relation("EventCoOrganizers")
  eventSeries       EventSeries[]   @relation("SeriesOrganizer")
  attendeeOf        EventAttendee[]
  attendances       Attendance[]
  actionItems       ActionItem[]    @relation("ActionItemOwner")
  minutesApproved   Minutes[]       @relation("MinutesApprover")
  auditLogs         AuditLog[]
  notifications     Notification[]
  roomBookings      RoomBooking[]   @relation("RoomBookings")
  accounts          Account[]
  sessions          Session[]
}

model Event {
  id             String         @id @default(cuid())
  title          String
  description    String?
  type           EventType      @default(MEETING)
  startAt        DateTime
  endAt          DateTime
  venueName      String?
  venueLat       Float?
  venueLng       Float?
  geofenceRadius Int            @default(100) // meters (PRD §6.6)
  colorCategory  ColorCategory? // PRD §6.5
  classification Classification @default(PUBLIC) // PRD §6.2
  ministryId     String
  ministry       Ministry       @relation(fields: [ministryId], references: [id], onDelete: Cascade)
  roomId         String?
  organizerId    String
  organizer      User           @relation("EventOrganizer", fields: [organizerId], references: [id])
  coOrganizers   User[]         @relation("EventCoOrganizers") // helpers who can also manage the event
  room           Room?          @relation("EventRoom", fields: [roomId], references: [id])
  reminderSentAt DateTime? // set once the 1h-before-start reminder has been emailed (idempotency)
  seriesId       String? // links recurring occurrences to their EventSeries
  series         EventSeries?   @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  attendees   EventAttendee[]
  attendances Attendance[]
  letters     Letter[]
  recordings  Recording[]
  minutes     Minutes?
  qrTokens    QRToken[]

  @@index([startAt])
  @@index([organizerId])
  @@index([seriesId])
  @@index([ministryId])
  @@index([roomId])
}

// PRD §6 — a recurring meeting series. Each occurrence is a full Event row
// (own check-in/QR/minutes); this record stores the rule that generated them.
model EventSeries {
  id          String              @id @default(cuid())
  frequency   RecurrenceFrequency
  interval    Int                 @default(1) // every N (days/weeks/months)
  endType     RecurrenceEndType
  count       Int? // when endType = COUNT
  until       DateTime? // when endType = UNTIL
  ministryId  String
  ministry    Ministry            @relation(fields: [ministryId], references: [id], onDelete: Cascade)
  organizerId String
  organizer   User                @relation("SeriesOrganizer", fields: [organizerId], references: [id])
  createdAt   DateTime            @default(now())

  events Event[]

  @@index([ministryId])
}

model EventAttendee {
  id            String       @id @default(cuid())
  eventId       String
  event         Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId        String?
  user          User?        @relation(fields: [userId], references: [id])
  externalName  String? // external guest without an account
  externalEmail String?
  status        InviteStatus @default(INVITED)
  rsvpTokenHash String? // SHA-256 only; the bearer token is sent by email and never persisted
  respondedAt   DateTime?
  createdAt     DateTime     @default(now())

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([rsvpTokenHash])
}

model Attendance {
  id               String        @id @default(cuid())
  eventId          String
  event            Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId           String?
  user             User?         @relation(fields: [userId], references: [id])
  externalName     String?
  externalEmail    String? // external guest's email — disambiguates same-named guests
  checkInAt        DateTime      @default(now())
  method           CheckInMethod @default(QR)
  lat              Float?
  lng              Float?
  gpsAccuracy      Float? // raw accuracy in meters (PRD §6.6 anti-spoofing)
  withinGeofence   Boolean?
  mockLocationFlag Boolean       @default(false)
  ipAddress        String?
  createdAt        DateTime      @default(now())

  // One attendance per logged-in user per event (PRD §6.6). userId is nullable and
  // Postgres treats NULLs as distinct, so external guests keep their app-level dedupe.
  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
}

model Letter {
  id            String        @id @default(cuid())
  eventId       String
  event         Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  colorCategory ColorCategory @default(GREEN)
  title         String
  body          String // rich-text / HTML
  pdfUrl        String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([eventId])
}

model Recording {
  id             String          @id @default(cuid())
  eventId        String
  event          Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  fileUrl        String
  durationSec    Int?
  classification Classification  @default(PUBLIC)
  status         RecordingStatus @default(UPLOADED)
  createdAt      DateTime        @default(now())

  transcript Transcript?

  @@index([eventId])
}

model Transcript {
  id          String    @id @default(cuid())
  recordingId String    @unique
  recording   Recording @relation(fields: [recordingId], references: [id], onDelete: Cascade)
  provider    String? // e.g. "openai-whisper"
  segments    Json // [{ speaker, start, end, text }]
  createdAt   DateTime  @default(now())
}

model Minutes {
  id           String        @id @default(cuid())
  eventId      String        @unique
  event        Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  body         String        @default("")
  summary      String?
  status       MinutesStatus @default(DRAFT)
  approvedById String?
  approver     User?         @relation("MinutesApprover", fields: [approvedById], references: [id])
  publishedAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  actionItems ActionItem[]
}

model ActionItem {
  id        String           @id @default(cuid())
  minutesId String
  minutes   Minutes          @relation(fields: [minutesId], references: [id], onDelete: Cascade)
  title     String
  ownerId   String?
  owner     User?            @relation("ActionItemOwner", fields: [ownerId], references: [id])
  ownerName String?
  dueDate   DateTime?
  reminderSentAt DateTime?
  point     ActionItemPoint  @default(ACTION_POINT)
  status    ActionItemStatus @default(TODO)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([minutesId])
  @@index([ownerId])
  @@index([reminderSentAt])
}

/// Append-only audit trail (PRD §7).
model AuditLog {
  id         String    @id @default(cuid())
  ministryId String?
  ministry   Ministry? @relation(fields: [ministryId], references: [id], onDelete: SetNull)
  actorId    String?
  actor      User?     @relation(fields: [actorId], references: [id])
  action     String // e.g. "CHECK_IN", "PUBLISH_MINUTES"
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime  @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([ministryId])
}

/// In-app notifications for events (invites, minutes, action items).
model Notification {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  ministryId String?
  ministry   Ministry? @relation(fields: [ministryId], references: [id], onDelete: SetNull)
  type       String // e.g. "INVITE", "MINUTES_PUBLISHED", "ACTION_ITEM_ASSIGNED", "RSVP"
  title      String
  body       String
  link       String? // in-app URL (e.g. /events/123)
  read       Boolean   @default(false)
  createdAt  DateTime  @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
  @@index([ministryId])
}

/// Dynamic / rotating signed QR token for check-in (PRD §6.1).
model QRToken {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([eventId])
}

// ── Room Booking models ─────────────────────────────────────────────────────

model Room {
  id         String   @id @default(cuid())
  ministryId String
  ministry   Ministry @relation(fields: [ministryId], references: [id], onDelete: Cascade)
  name       String
  location   String
  capacity   Int
  amenities  String[] // e.g., ["Projector", "Whiteboard"]
  latitude   Float?
  longitude  Float?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  bookings RoomBooking[]
  events   Event[]       @relation("EventRoom")

  @@unique([ministryId, name])
  @@index([location])
  @@index([ministryId])
}

model RoomBooking {
  id            String             @id @default(cuid())
  ministryId    String
  ministry      Ministry           @relation(fields: [ministryId], references: [id], onDelete: Cascade)
  roomId        String
  userId        String
  startTime     DateTime
  endTime       DateTime
  purpose       RoomBookingPurpose
  attendeeCount Int?
  notes         String?
  status        RoomBookingStatus  @default(CONFIRMED)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation("RoomBookings", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, startTime, endTime])
  @@index([userId])
  @@index([roomId])
  @@index([startTime])
  @@index([ministryId])
}

// ── Auth.js (NextAuth) models ───────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Public calendar events — visible to all without login, managed by admins.
model PublicEvent {
  id           String            @id @default(cuid())
  title        String
  description  String?
  category     PublicEventCategory?
  startAt      DateTime
  endAt        DateTime
  venueName    String?
  bannerImage  String? // Cloudinary secure URL or legacy "/public-uploads/<name>" path
  externalUrl  String?
  contactEmail String?
  contactPhone String?
  status       PublicEventStatus @default(DRAFT)
  publishedAt  DateTime?
  ministryId   String?
  ministry     Ministry?         @relation(fields: [ministryId], references: [id], onDelete: SetNull)
  createdById  String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  invitedMinistries Ministry[]   @relation("PublicEventInvites")

  @@index([status, startAt])
  @@index([ministryId])
}
